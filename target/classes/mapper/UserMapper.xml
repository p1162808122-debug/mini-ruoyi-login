<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pengzhipeng.miniruoyi.mapper.UserMapper">

    <select id="selectByUsername"
            parameterType="string"
            resultType="com.pengzhipeng.miniruoyi.domain.User">
        SELECT id,
               username,
               password_hash,
               salt,
               display_name,
               enabled,
               role_key,
               permission
        FROM app_user
        WHERE username = #{username}
    </select>

</mapper>

